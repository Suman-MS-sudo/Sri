{
  "name": "my-world-my-sri",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "faces": "node scripts/prepare-faces.mjs",
    "avatar": "node scripts/draw-avatar.mjs && node scripts/prepare-faces.mjs --no-align",
    "frame": "node scripts/frame-face.mjs",
    "sheet": "node scripts/split-sheet.mjs",
    "dev:phone": "vite --port 443 --strictPort"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "framer-motion": "^12.38.0",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
