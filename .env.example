# Live two-player games (Supabase Realtime). Without these the game runs in local test mode
# (two tabs of the same browser). On Vercel, adding Supabase from the Storage tab sets the
# NEXT_PUBLIC_* versions automatically.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
